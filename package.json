{
  "name": "gitarena",
  "version": "1.0.0",
  "description": "A live gamification dashboard that turns GitHub org activity into a real-time leaderboard, streaks, badges, and boss fights — designed for the team TV screen.",
  "author": "Alae Moudni",
  "license": "MIT",
  "homepage": "https://github.com/Societe-tangeroise-de-maintenance/GitArena",
  "repository": {
    "type": "git",
    "url": "https://github.com/Societe-tangeroise-de-maintenance/GitArena.git"
  },
  "keywords": [
    "gamification",
    "github",
    "leaderboard",
    "developer-tools",
    "dashboard",
    "real-time",
    "react",
    "typescript",
    "tv-dashboard",
    "boss-fight",
    "streaks",
    "open-source"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "server": "tsx server/index.ts",
    "start": "concurrently \"npm run server\" \"npm run dev\""
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "*",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/geist": "*",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "framer-motion": "^11.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.9",
    "puppeteer-core": "^24.43.1",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.21.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
